# Optional OpenAI-compatible LLM used by the Portfolio Manager.
CRYPTO_TRADING_AGENTS_LLM_API_KEY=
CRYPTO_TRADING_AGENTS_LLM_BASE_URL=https://api.openai.com/v1
CRYPTO_TRADING_AGENTS_LLM_MODEL=gpt-5.6

# Reports are written here.
CRYPTO_TRADING_AGENTS_REPORTS_DIR=reports

# Optional OKX private account access. Public market data does not need these.
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_TIMEOUT=20
OKX_BASE_URL=https://www.okx.com
OKX_TIMEOUT=20
OKX_CONFIG_PATH=../.okx_config.json
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
